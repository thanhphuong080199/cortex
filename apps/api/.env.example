PORT=3001
SUPABASE_URL=http://127.0.0.1:54321
# Optional HS256 shared-secret fallback (legacy Supabase projects). Leave unset to verify
# via the project's JWKS endpoint instead (works for both local dev and production).
# NOTE: as of Supabase CLI 2.x, the local stack issues asymmetric (ES256) JWTs by default,
# so `supabase status`'s reported JWT_SECRET will NOT verify real access tokens locally —
# leave this unset locally and let the guard use JWKS.
SUPABASE_JWT_SECRET=<from `supabase status`; only for legacy HS256 projects>
SUPABASE_ANON_KEY=<tests only>
SUPABASE_SERVICE_ROLE_KEY=<tests only>
