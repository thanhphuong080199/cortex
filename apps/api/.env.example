PORT=3001
SUPABASE_URL=http://127.0.0.1:54321
# Optional HS256 shared-secret fallback (legacy Supabase projects). Leave unset to verify
# via the project's JWKS endpoint instead (works for both local dev and production).
# NOTE: as of Supabase CLI 2.x, the local stack issues asymmetric (ES256) JWTs by default,
# so `supabase status`'s reported JWT_SECRET will NOT verify real access tokens locally —
# leave this unset locally and let the guard use JWKS.
SUPABASE_JWT_SECRET=<from `supabase status`; only for legacy HS256 projects>
SUPABASE_ANON_KEY=<tests only>
# NOT "tests only" since phase 2, which is what this line used to say. The enrichment
# pipeline and search_notes read note_chunks / note_enrichment -- RLS enabled with no
# policies, invisible to `authenticated` by design -- so the API itself needs this and
# refuses to boot without it. See docs/deploy.md's SUPABASE_SERVICE_ROLE_KEY section.
SUPABASE_SERVICE_ROLE_KEY=<required by the API, not just tests>
# Direct Postgres connection (pg-boss needs this; PostgREST/Supabase client don't).
# Must name the SAME database as SUPABASE_URL above -- boot refuses to start otherwise.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
GEMINI_API_KEY=<Gemini API key for the enrichment pipeline>
GEMINI_TIER=free
ENRICH_MONTHLY_BUDGET_USD=5
