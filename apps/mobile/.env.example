EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<hosted anon key — set in Task 12>
# Copy verbatim from the PowerSync Dashboard (instance → Instance URL). Do not assemble it
# from an instance id: the host varies by instance and region. See docs/deploy.md.
EXPO_PUBLIC_POWERSYNC_URL=<pasted verbatim from the PowerSync dashboard>
# The deployed API. PowerSync's uploadData hook posts CRUD batches to <this>/sync/upload.
EXPO_PUBLIC_API_URL=https://<service>.up.railway.app
