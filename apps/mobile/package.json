{
  "name": "@cortex/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "op-sqlite": {
    "sqlcipher": true,
    "fts5": true
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
