  },
  "dependencies": {
    "@cortex/shared": "workspace:*",
    "@cortex/sync": "workspace:*",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@op-engineering/op-sqlite": "^17.1.3",
    "@powersync/common": "^2.0.0",
    "@powersync/react-native": "^2.0.0",
    "@supabase/supabase-js": "^2.48.0",
    "expo": "^57.0.9",
    "expo-auth-session": "^57.0.5",
    "expo-constants": "^57.0.8",
    "expo-crypto": "^57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "^57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "^57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "^57.0.1",
    "expo-web-browser": "^57.0.2",
    "react": "^19.2.3",
    "react-native": "^0.86.2",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@cortex/config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.17",
    "better-sqlite3": "^13.0.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
