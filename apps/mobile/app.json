{
  "expo": {
    "name": "Cortex",
    "slug": "cortex",
    "scheme": "cortex",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.cortex.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.cortex.mobile",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-dev-client",
        {
          "android": {
            "embeddedBundle": true,
            "skipOnboarding": true,
            "showMenuAtLaunch": false,
            "toolsButton": false
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "369efb26-9201-440f-95f0-71fa1dec0360"
      }
    },
    "owner": "thanhphuong080199"
  }
}
