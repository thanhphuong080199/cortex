{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },

    // typecheck/test depend on the package's OWN build, not just upstream ones:
    // `next build` regenerates .next/types/** (which apps/web/tsconfig.json includes),
    // and tsc racing that rewrite fails with TS6053 "File not found" on files it
    // globbed moments earlier.
    "typecheck": { "dependsOn": ["^build", "build"] },
    "lint": {},

    // Turbo runs tasks in strict env mode: a task process only sees the env vars listed
    // here, so anything the CI job exports (see .github/workflows/ci.yml, "Export local
    // Supabase keys as app env vars") is stripped before vitest starts unless it is named
    // below. Omitting them made every @cortex/db suite die at import time with
    // "Error: supabaseUrl is required" from createClient() in src/test/clients.ts.
    // Declaring them in `env` (rather than `passThroughEnv`) also folds their values into
    // the task hash, so pointing the suites at a different Supabase stack correctly
    // invalidates the cache instead of replaying results from the previous one.
    "test": {
      "dependsOn": ["^build", "build"],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "CORS_ORIGINS",
        "PORT"
      ]
    }
  }
}
